# 複製這個檔案為 .env，填入你自己的值 — .env 本身絕對不會被 git 追蹤（見 .gitignore）
# 正式排程（GitHub Actions）不用 .env，改用 repo 的 Secrets 設定，見 README「資安」章節

# ── Google Sheets（讀取收件人名單）──
# 建立方式：Google Cloud Console → 建立 Service Account → 啟用 Sheets API →
# 下載 JSON 金鑰 → 把整個 JSON 內容貼成一行字串放這裡
# 權限只給「檢視者」(Viewer)，不要給編輯權限
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
GOOGLE_SHEET_ID=your_sheet_id_here

# ── Gmail（寄信）──
# 建議用 Gmail API + OAuth2，scope 只開 gmail.send（最小權限，不能讀信、不能刪信）
# 建立方式：Google Cloud Console → 啟用 Gmail API → OAuth 同意畫面 → 下載 client secret
GMAIL_CLIENT_ID=your_client_id
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_SENDER_EMAIL=your_email@gmail.com

# ── 市場數據來源（皆為免費/公開 API，不需金鑰）──
# 黃金與台股數據透過 yfinance 抓取，美債殖利率透過公開來源抓取，此區塊保留供未來擴充付費資料源
# NEWS_API_KEY=optional_if_you_upgrade_from_rss

# ── 新聞篩選/摘要（選用）──
# 用於 skills/news_curator.py：依 rules/CONTENT_RULES.md 的權重規則篩選+摘要新聞
# 不設定的話會自動降級成陽春版（取前5則候選新聞，品質較低但流程仍可執行）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── 執行環境 ──
TIMEZONE=Asia/Taipei
