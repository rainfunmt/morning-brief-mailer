<div style="font-family:{{ theme.fonts.body }};max-width:{{ theme.layout.max_width_px }}px;margin:0 auto;padding:24px;background:{{ theme.colors.bg }};color:{{ theme.colors.ink }};line-height:1.75;">

<p style="font-size:15px;margin:0 0 18px;">{{ recipient_name }} 您好，</p>

<div style="border-bottom:3px solid {{ theme.colors.accent }};padding-bottom:10px;margin-bottom:20px;">
  <h1 style="font-size:{{ theme.layout.heading_size_px }}px;font-weight:{{ theme.layout.heading_weight }};margin:0;font-family:{{ theme.fonts.heading }};color:{{ theme.colors.ink }};">{{ theme.branding.title }}</h1>
  <div style="font-size:13px;color:{{ theme.colors.muted }};margin-top:4px;">{{ date_display }}</div>
</div>

{% if market_closed_note %}
<p style="font-size:13px;color:{{ theme.colors.muted }};margin:0 0 18px;">※ {{ market_closed_note }}</p>
{% endif %}

<h2 style="font-size:13px;font-weight:700;letter-spacing:.04em;color:{{ theme.colors.accent }};text-transform:uppercase;margin:0 0 8px;">今日一句</h2>
<p style="font-size:15px;color:{{ theme.colors.ink_soft }};margin:0 0 26px;background:{{ theme.colors.line_soft }};padding:14px 16px;border-radius:4px;border-left:3px solid {{ theme.colors.accent }};">{{ thesis }}</p>

<h2 style="font-size:17px;font-weight:700;color:{{ theme.colors.ink }};border-bottom:2px solid {{ theme.colors.accent }};padding-bottom:6px;margin:0 0 16px;">國際要聞</h2>
<ol style="padding-left:20px;color:{{ theme.colors.ink_soft }};font-size:{{ theme.layout.body_size_px }}px;margin:0 0 8px;">
  {% for item in news_items %}
  <li style="margin-bottom:16px;">
    <strong style="font-weight:700;color:{{ theme.colors.ink }};">{{ item.title }}</strong><br>
    {{ item.summary }}
  </li>
  {% endfor %}
</ol>

<h2 style="font-size:17px;font-weight:700;color:{{ theme.colors.ink }};border-bottom:2px solid {{ theme.colors.accent }};padding-bottom:6px;margin:28px 0 6px;">市場數據</h2>
<p style="font-size:12.5px;color:{{ theme.colors.muted }};margin:0 0 10px;">{{ market_data_asof }}</p>
<table style="width:100%;border-collapse:collapse;font-size:14px;">
  {% for row in market_rows %}
  <tr style="background:{{ theme.colors.line_soft if loop.index0 is even else theme.colors.bg }};">
    <td style="padding:10px 12px;border-bottom:1px solid {{ theme.colors.line }};color:{{ theme.colors.ink_soft }};">{{ row.label }}</td>
    <td style="padding:10px 12px;border-bottom:1px solid {{ theme.colors.line }};text-align:right;font-family:{{ theme.fonts.mono }};font-weight:600;color:{{ theme.colors.up if row.positive else theme.colors.down if row.positive == false else theme.colors.ink }};">{{ row.value }}</td>
  </tr>
  {% endfor %}
</table>

<p style="font-size:12px;color:{{ theme.colors.muted }};border-top:1px solid {{ theme.colors.line_soft }};padding-top:12px;margin-top:24px;">{{ theme.branding.footer_disclaimer }}</p>

</div>
